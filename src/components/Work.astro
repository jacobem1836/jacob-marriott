---
interface Project {
  index: string;
  title: string;
  status: string;
  body: string[];
  href?: string;
  quote?: { text: string; by: string };
}

const projects: Project[] = [
  {
    index: "01",
    title: "Innovative Travel",
    status: "christchurch, nz",
    body: [
      "A tour wholesaler of 15+ people selling international holidays. The team are salespeople, and they were spending most of the day on data entry. The same booking was typed into three or four systems. Documents came out of the booking system wrong and had to be fixed in Word before a customer saw them. Some records were still on paper, and nobody could see a customer's full history in one place.",
      "I sat with every role in the business and wrote a plan for how bookings should move through it. The first two builds were a live feed of their tours, now used by Tour Atlas and other booking platforms, and a document generator that turns a booking into a finished itinerary in the company's own voice and layout. Before anything goes out, it checks that every price and date matches the booking. A central customer database is next on the plan.",
    ],
  },
  {
    index: "02",
    title: "Queenstown Chamber of Commerce",
    status: "queenstown, nz",
    body: [
      "Every quarter the Chamber turns a member survey into a published report. I built the tool that produces it from the survey export as an editable Word document. The figures are calculated in code, and I tested them against a past published report until they matched. AI drafts the commentary, and a draft is rejected if it quotes a number that isn't in the data.",
    ],
  },
  {
    index: "03",
    title: "StrataCare Australia",
    status: "brisbane · technology officer",
    body: [
      "I advise StrataCare on an AI overhaul of the business and redesign their processes so the technology does more of the work. I built a reporting engine over their SharePoint files so staff can ask for a report or spreadsheet instead of putting it together by hand. Its first big job pulled 1,643 claim records into a single register. I've also audited their IT spend and rebuilt their website.",
    ],
  },
  {
    index: "04",
    title: "In a Pickle",
    status: "brisbane",
    href: "https://inapickle.com.au",
    body: [
      "A website for a boutique caterer, with menus, quotes and bookings. I built a custom CMS so the owner can edit text, photos and menus directly on the page.",
    ],
    quote: {
      text: "Our website was in dire need of a major revamp and we were lucky enough to come across Jacob Marriott. Dealing with Jacob has been awesome. His attention to detail and knowledge around an online presence has helped create a much more user-friendly platform for our clients to navigate. In the short time since we launched we have already noticed a major increase in traffic to the site with many of the new features he has applied being utilised by our customers. Jacob not only designed our website but he can manage behind the scenes for us too. 100% recommend!!",
      by: "Esther Downie, owner, In a Pickle",
    },
  },
];

const extras = [
  {
    title: "A personal AI that knows your work.",
    body: "I set up an AI environment on your own computer with your files, notes and way of working already built in. It remembers what you're working on and takes the repetitive jobs off your week, so you aren't explaining yourself from scratch every time.",
  },
  {
    title: "AI that knows your business.",
    body: "I build AI systems that understand how your company runs: your processes, your clients and how you like things done. Staff use it like any AI assistant, but it already has that context, so the answers fit your business. Brain Console started as one of these.",
  },
];
---

<section id="work" class="work container" aria-labelledby="work-heading">
  <p class="section-label work__label">
    <span aria-hidden="true">03 / </span>work
  </p>

  <h2 id="work-heading" class="visually-hidden">Selected work</h2>

  <ol class="work__list">
    {projects.map((p) => (
      <li class="work__item">
        <header class="work__header">
          <p class="work__index mono" aria-hidden="true">work / {p.index}</p>
          <h3 class="work__title">
            {p.href ? (
              <a class="work__title-link" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.title}
                <span class="work__title-arrow" aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            ) : (
              p.title
            )}
          </h3>
          <p class="work__status mono">{p.status}</p>
        </header>
        <div class="work__body">
          {p.body.map((para) => <p>{para}</p>)}
          {p.quote && (
            <figure class="work__quote">
              <blockquote><p>"{p.quote.text}"</p></blockquote>
              <figcaption class="mono">{p.quote.by}</figcaption>
            </figure>
          )}
        </div>
      </li>
    ))}
  </ol>

  <div class="work__extras">
    <p class="section-label work__label">also</p>
    <ul class="work__extras-list">
      {extras.map((e) => (
        <li>
          <h3 class="work__extras-title">{e.title}</h3>
          <p>{e.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: var(--space-12);
  }

  .work__label {
    color: var(--color-accent-muted);
  }

  .work__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-12);
  }

  .work__item {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .work__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .work__header {
    display: grid;
    gap: var(--space-2);
  }

  .work__index {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    text-transform: lowercase;
  }

  .work__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }

  .work__title-link {
    color: inherit;
    border-bottom: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .work__title-link:hover,
  .work__title-link:focus-visible {
    color: var(--color-accent);
    border-bottom: 0;
  }

  .work__title-link:active {
    color: var(--color-accent-muted);
  }

  .work__title-arrow {
    font-size: 0.65em;
    color: var(--color-text-dim);
    transition: color var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-fast) var(--ease-out-expo);
  }

  .work__title-link:hover .work__title-arrow,
  .work__title-link:focus-visible .work__title-arrow {
    color: var(--color-accent);
    transform: translate(0.1em, -0.1em);
  }

  .work__status {
    font-size: var(--text-xs);
    color: var(--color-accent-muted);
    text-transform: lowercase;
  }

  .work__body {
    font-size: var(--text-base);
    max-width: 62ch;
    color: var(--color-text);
  }

  .work__body {
    display: grid;
    gap: var(--space-4);
  }

  .work__body p {
    max-width: none;
  }

  .work__quote {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-accent);
    display: grid;
    gap: var(--space-3);
  }

  .work__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-text);
  }

  .work__quote figcaption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .work__extras {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .work__extras-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-8);
  }

  .work__extras-list p {
    margin-top: var(--space-2);
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: var(--leading-prose);
    color: var(--color-text-muted);
  }

  .work__extras-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  @media (min-width: 48rem) {
    .work__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: var(--space-8) clamp(1.5rem, -1rem + 8vw, 5rem);
      align-items: start;
    }

    .work__header {
      grid-column: 1;
      padding-top: 0.35rem;
    }

    .work__body {
      grid-column: 2;
      grid-row: 1;
      font-size: var(--text-lg);
      line-height: var(--leading-prose);
    }

    .work__extras-list {
      margin-left: calc(10rem + clamp(1.5rem, -1rem + 8vw, 5rem));
    }

    .work__title {
      font-size: var(--text-xl);
    }
  }
</style>
